# Configuração pessoal (contém IDs de projeto e bucket do executor)
config/config.json

# Dados: o repositório versiona código; os dados vivem no data lake
data/*
!data/.gitkeep
*.parquet
*.csv
*.xlsx

# Excecao: os relatorios de reports/ sao documentacao gerada pelo codigo,
